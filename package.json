{
  "name": "sliceme",
  "version": "0.3.0",
  "description": "Coordination for parallel coding agents: campaign DAG, git worktrees, plan-time directory ownership, approved delivery.",
  "license": "Apache-2.0",
  "author": "sliceme",
  "homepage": "https://github.com/ming6ao/sliceme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming6ao/sliceme.git"
  },
  "bugs": {
    "url": "https://github.com/ming6ao/sliceme/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "sliceme",
    "agents",
    "orchestration"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests",
    "typecheck": "node tools/typecheck.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    "README.md",
    "LICENSE",
    "bin/",
    "sliceme/",
    "tools/",
    "docs/",
    "integrations/pi/agents/",
    "integrations/pi/common.ts",
    "integrations/pi/campaign-resource.ts",
    "integrations/pi/coordinator.ts",
    "!sliceme/__pycache__",
    "!sliceme/**/*.pyc",
    "!tools/typecheck.mjs"
  ],
  "pi": {
    "extensions": [
      "./integrations/pi/coordinator.ts"
    ],
    "skills": []
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "pi-subagents": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "pi-subagents": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
